# The frontend talks to the PO Bunker API (backend/) on the same origin: Nginx
# proxies /api/ in production and the Vite dev server proxies it in development.
# Nothing is needed for that. Optional overrides:

# Build for an API on another origin (the refresh cookie is then sent cross-site;
# normally leave this unset).
# VITE_API_URL=https://api.example.com

# Dev only: where `npm run dev` forwards /api (default http://127.0.0.1:8080).
# VITE_PROXY_TARGET=http://127.0.0.1:8080
