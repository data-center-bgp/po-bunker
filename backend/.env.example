# PO Bunker API settings. Copy to .env for local work; on the VPS the same keys
# live in deploy/.env (see deploy/docker-compose.yml). Never commit real values.

# development | production. Production refuses weak secrets and insecure cookies.
APP_ENV=development
PORT=8080

# Local Postgres (a scratch database, not the shared CGA project).
DATABASE_URL=postgres://postgres@127.0.0.1:5432/po_bunker_dev?sslmode=disable
DB_MAX_CONNS=10

# Production: at least 32 random characters each, e.g. `openssl rand -hex 32`.
JWT_SECRET=
FILE_SIGNING_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# true in production (default). Set false only for plain http://localhost.
COOKIE_SECURE=false

# Uploaded logos and Delivery Order files.
FILES_DIR=./data/files

# Proxies whose X-Forwarded-For is trusted (the local Nginx / Docker bridge).
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# Company SMS vessel API.
VESSEL_API_URL=https://sms.barokahmarineconsulting.com/api/csbd/ships
VESSEL_API_TOKEN=
